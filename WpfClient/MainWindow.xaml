<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 圖像生成器" Height="500" Width="600">
    <Grid>
        <StackPanel Margin="20">
            <TextBox x:Name="UserInput" FontSize="16" Height="50" Margin="0,0,0,10" MaxLength="100">
                <TextBox.Text>
                    <Binding Path="Text" UpdateSourceTrigger="PropertyChanged" />
                </TextBox.Text>
            </TextBox>
            <Button Content="生成圖像" Click="GenerateImage" FontSize="16" Height="30" Margin="0,0,0,10"/>
            <TextBlock x:Name="AiResponse" FontSize="16" TextWrapping="Wrap" Height="30" Margin="0,0,0,10" 
                       HorizontalAlignment="Center" Foreground="DarkBlue"/>
            <Border BorderThickness="1" BorderBrush="Gray" Width="300" Height="300" HorizontalAlignment="Center">
                <Image x:Name="AiImage" Width="300" Height="300" Stretch="Uniform"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
